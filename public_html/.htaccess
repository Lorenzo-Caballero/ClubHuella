# Manejar preflight OPTIONS (CORS)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 👉 IMPORTANTE: React Router fallback
    RewriteBase /

    # Si NO es archivo real
    RewriteCond %{REQUEST_FILENAME} !-f
    # Si NO es carpeta real
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirigir todo a index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Evitar cache agresivo
<IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
</IfModule>

# Debug PHP (opcional)
php_flag display_errors off
php_value error_reporting 32767

# No exponer archivos de depuración, configuración o metadatos privados.
<FilesMatch "^(debug\.txt|config\.php|\.env|.*\.log)$">
    Require all denied
</FilesMatch>
