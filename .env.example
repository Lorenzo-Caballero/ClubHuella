# Copiá este archivo como .env y completá los valores.
# Solo variables con prefijo REACT_APP_ llegan al bundle (Create React App).
# Nunca pongas secretos acá: quedan visibles en el JS del navegador.

REACT_APP_API_BASE_URL=https://clubhuella.com

REACT_APP_DESIGNS_ENDPOINT=/disenos.php
REACT_APP_PAYMENTS_ENDPOINT=/payments_envios.php

REACT_APP_GENERATION_TIMEOUT_MS=150000
REACT_APP_REQUEST_TIMEOUT_MS=30000

REACT_APP_TSHIRT_PRICE=42990

REACT_APP_PICKUP_ADDRESS=Av. Héctor Jara 22
REACT_APP_PICKUP_CITY=Mar del Plata
REACT_APP_PICKUP_POSTAL_CODE=7600

# Meta Pixel (Facebook/Instagram Ads) — Events Manager > Pixel > ID.
# Sin este valor, el pixel no se inicializa (no se trackea nada).
REACT_APP_META_PIXEL_ID=
